PORT=4000
NODE_ENV=development
# MongoDB connection string, e.g. from MongoDB Atlas:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/wesleychapel?retryWrites=true&w=majority
MONGODB_URI=
# Optional: database name, if it isn't in the URI (default "wesleychapel")
# MONGODB_DB=wesleychapel
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed origins; omit to allow all (dev only)
# CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
AUTO_APPROVE_LISTINGS=false
AUTO_APPROVE_EVENTS=false
MODERATE_REVIEWS=false
