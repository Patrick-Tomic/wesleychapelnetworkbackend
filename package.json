{
  "name": "wesleychapel-backend",
  "version": "1.0.0",
  "description": "REST API for a local business directory (listings, events, blog, plans, reviews) on MongoDB",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test test/*.test.js",
    "migrate:sqlite": "node src/migrate-sqlite.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "better-sqlite3": "^12.11.1",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1"
  }
}
